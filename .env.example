# JuriLex — variables d'environnement
# Copier ce fichier vers `.env` et renseigner les valeurs réelles.
# Ne jamais commiter `.env` ni y placer de secrets réels ici.

# Clé d'API Gemini (conservée exclusivement côté serveur)
GEMINI_API_KEY=votre_cle_api_ici

# Modèle Gemini utilisé pour l'explication
# (alternative économique : gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.5-flash

# Limites des documents importés
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=20

# Répertoire de cache des modèles (laisser vide pour le cache par défaut)
MODEL_CACHE_DIR=

# Répertoire des fichiers temporaires (nettoyés automatiquement)
TEMP_DIR=/tmp/jurilex

# Délai maximal d'une opération (secondes)
REQUEST_TIMEOUT_SECONDS=300

# Origines autorisées pour le CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173
